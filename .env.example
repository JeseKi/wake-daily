# 觉知日记 Demo 最小配置

# 本地开发保持 dev；测试由 pytest 自行设置 APP_ENV=test
APP_ENV=dev

# 后端端口（run.py 使用）
PORT=8000

# 前端开发服务器来源；如果只从 http://localhost:8000 访问构建后的页面，可保持默认
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite 数据库文件路径（相对项目根目录）
DATABASE_PATH=data/database.db

# JWT / 签名密钥。生产部署必须改成高强度随机值
JWT_SECRET_KEY=change-me-in-production
APP_SECRET_KEY=change-me-in-production

# 首次初始化数据库时创建的管理员账号
INIT_ADMIN_NAME=admin
INIT_ADMIN_PASSWORD=admin123
INIT_ADMIN_EMAIL=admin@example.com

# 用于生成密码重置、密码修改等邮件链接；本地可用 http://localhost:8000
APP_DOMAIN=http://localhost:8000

# 邮件发送。留空时开发环境会把验证码/链接写入日志，不会真实发信
MAIL_SENDER_EMAIL=
MAIL_SENDER_PASSWORD=
MAIL_SENDER_NAME=觉知日记

